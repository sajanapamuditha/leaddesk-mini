// Prisma schema for LeadDesk Mini
// Default datasource is SQLite for zero-config local dev.
// For production (e.g. Vercel), swap provider to "postgresql" and set
// DATABASE_URL to a hosted Postgres connection string (Neon/Supabase/Railway
// all have free tiers). No other code changes are required — Prisma's
// query API is provider-agnostic here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  budgetRange String
  message     String
  status      String   @default("NEW") // NEW | CONTACTED | CLOSED — enforced in app code via Zod, not the DB, since SQLite has no native enum type
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Single admin user table. Password is bcrypt-hashed, never stored in
// plaintext. Seeded via prisma/seed.ts — not hardcoded in application code.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
